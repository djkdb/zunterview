# ── Server-only (never exposed to the browser) ─────────────────────────────
# Anthropic API key used by the Node API layer (server/). Leave empty to run
# the whole app in MOCK MODE.
ANTHROPIC_API_KEY=

# Optional overrides
# AI_MODEL=claude-sonnet-5-5   # default; claude-opus-5-5 is stronger at about twice the cost
# AI_EFFORT=low            # low | medium | high — lower = faster interviewer turns
# PORT=8787
# RATE_LIMIT_PER_MINUTE=40

# ── Interviewer voices (optional, server-only) ──────────────────────────────
# Typecast neural TTS: native Korean voices, tried first when set (server/tts.ts has the seat voices).
TYPECAST_API_KEY=
# TYPECAST_VOICE_CENTER=  # 면접위원장 — a tc_… id from GET https://api.typecast.ai/v2/voices
# TYPECAST_VOICE_LEFT=    # 인사팀 면접관
# TYPECAST_VOICE_RIGHT=   # 실무 면접관
# TYPECAST_VOICE_STAFF=   # 호명하는 안내 직원
# TYPECAST_MODEL=         # default ssfm-v30

# ElevenLabs neural TTS (next after Typecast). Each interviewer gets their own voice;
# the built-in ones are ElevenLabs default voices reading Korean (server/tts.ts).
ELEVEN_API_KEY=
# ELEVEN_VOICE_CENTER=    # 면접위원장 — any voice id from your ElevenLabs voice library
# ELEVEN_VOICE_LEFT=      # 인사팀 면접관
# ELEVEN_VOICE_RIGHT=     # 실무 면접관
# ELEVEN_VOICE_STAFF=     # 호명하는 안내 직원
# ELEVEN_MODEL=           # default eleven_multilingual_v2; eleven_flash_v2_5 is faster and half the credits

# Fish Audio neural TTS (fallback when ElevenLabs fails, or used alone). Without a key the
# browser's built-in speech is used. Voice IDs are Fish Audio model IDs (the id in a
# voice's URL on fish.audio, or one you cloned yourself).
FISH_AUDIO_API_KEY=
# Voices are built in (server/tts.ts); set these only to use different ones.
# FISH_VOICE_CENTER=      # 면접위원장 (panel chair)
# FISH_VOICE_LEFT=        # 인사팀 면접관
# FISH_VOICE_RIGHT=       # 실무 면접관
# FISH_VOICE_STAFF=       # 대기실에서 호명하는 안내 직원
# FISH_VOICE_DEFAULT=     # used for any seat without its own voice
# FISH_AUDIO_MODEL=       # optional model header (e.g. s1, s2.1-pro); Fish default if empty

# ── Client (VITE_* values are bundled into the frontend — never put secrets here)
# auto = use the AI server when it reports a key, otherwise MOCK MODE
# mock = always MOCK MODE
VITE_AI_MODE=auto
# Base URL of the API layer. Empty = same origin (/api, proxied by Vite in dev).
VITE_API_BASE_URL=
